# Supabase — public values (EXPO_PUBLIC_ prefix exposes them to the JS bundle)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# RevenueCat
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=<your-ios-key>
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=<your-android-key>

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
