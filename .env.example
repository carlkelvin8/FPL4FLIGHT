# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public URL of your Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key — safe to expose in client code
SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — NEVER expose this in client code
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Admin Dashboard (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── Mobile App (Expo) ────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── RevenueCat (Subscriptions) ───────────────────────────────────────────────
REVENUECAT_API_KEY_IOS=<your-ios-key>
REVENUECAT_API_KEY_ANDROID=<your-android-key>

# ─── Sentry (Error tracking) ──────────────────────────────────────────────────
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ORG=<your-org>
SENTRY_PROJECT=<your-project>
SENTRY_AUTH_TOKEN=<your-auth-token>

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
FCM_SERVER_KEY=<your-fcm-server-key>

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=<your-sendgrid-key>
EMAIL_FROM=noreply@pilotforms.io

# ─── Node environment ─────────────────────────────────────────────────────────
NODE_ENV=development
