{
  "name": "@pilotforms/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared domain types, interfaces, and utilities for PilotForms™",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.22.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
